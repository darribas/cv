# Preview / scratch build artifacts.
# The committed, published PDF lives at docs/cv.pdf and is NOT ignored.
build/
*.png
.DS_Store

# Migration reference — the old LaTeX-built PDF, kept locally for comparison only
notes/cv-current.pdf

# Local Claude Code settings (settings.json, settings.local.json, …).
# Shared project skills under .claude/skills/ ARE tracked — they are part of
# the repo's tooling, not local machine state.
.claude/*
!.claude/skills/

# Python bytecode (tests import the src/ scripts as modules)
__pycache__/

# Subset CVs are private: configs and outputs live outside the repo, and these
# rules plus a CI tripwire (build-site.yml) keep any stray copy from being
# committed. The annotated template is the only TOML file tracked.
subsets/
*.toml
!src/subset.template.toml
